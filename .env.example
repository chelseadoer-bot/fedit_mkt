# Meta Marketing API — 비즈니스 관리자 > 시스템 사용자 > 토큰 생성 (ads_read 권한)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v24.0
# 분석 프로필: b2b(랜딩·가입 전환, 메시지 앵글/페르소나 축) 또는 commerce(구매·ROAS, 구도/할인 축)
CREATIVE_PROFILE=b2b
# 핵심 전환 이벤트 (기본: 랜딩페이지 조회). 가입으로 바꾸려면 complete_registration
# META_CONVERSION_ACTION=landing_page_view
# 이 광고비 미만 소재는 진단하지 않고 '모니터링'
MIN_SPEND=10000

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Amplitude (선택) — 가입·체험·활성화를 소재/채널별로 붙임
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
# AMPLITUDE_REGION=us
# AMPLITUDE_ACTIVATION_EVENT=excel_download
